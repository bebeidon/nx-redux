diff --git a/Makefile b/Makefile
index 878e147..a71169c 100644
--- a/Makefile
+++ b/Makefile
@@ -196,6 +196,21 @@ else ifeq ($(platform), ps2)
    STATIC_LINKING = 1
    OLD_GCC = 1
 
+# NxRedux desktop (macOS/Linux host build)
+else ifeq ($(platform), desktop)
+   TARGET := $(TARGET_NAME)_libretro.so
+   CC = $(CROSS_COMPILE)gcc
+   CXX = $(CROSS_COMPILE)g++
+   AR = $(CROSS_COMPILE)ar
+   fpic := -fPIC
+   ifeq ($(shell uname -s), Darwin)
+      # macOS ld rejects GNU --version-script; plain -shared yields a
+      # dlopen-able Mach-O .so.
+      SHARED := -shared
+   else
+      SHARED := -shared -Wl,--no-undefined -Wl,--version-script=link.T
+   endif
+
 # PSP
 else ifeq ($(platform), psp1)
    TARGET := $(TARGET_NAME)_libretro_$(platform).a
